{%- style -%}
  .bryda-varfor-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .bryda-varfor-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
  .bryda-varfor-{{ section.id }} .wrap { max-width: 100rem; }
  .bryda-varfor-{{ section.id }} .eyebrow { font-family: var(--font-mono-family); font-size: 1.3rem; line-height: 1.5; letter-spacing: 0.04em; color: #4F5B45; margin: 0 0 1.2rem; max-width: 60ch; }
  .bryda-varfor-{{ section.id }} h2 { font-size: clamp(2.8rem, 2.2rem + 1.8vw, 4rem); line-height: 1.05; margin: 0; max-width: 24ch; text-wrap: balance; }
  .bryda-varfor-{{ section.id }} .text { margin-top: 2rem; max-width: 60ch; }
  .bryda-varfor-{{ section.id }} .text p { font-size: 1.7rem; line-height: 1.6; margin: 0 0 1.2rem; }
  .bryda-varfor-{{ section.id }} .text p:last-child { margin-bottom: 0; }
  @media screen and (min-width: 750px) { .bryda-varfor-{{ section.id }} .text p { font-size: 1.8rem; } }
  .bryda-varfor-{{ section.id }} .highlight { margin: 2.4rem 0 0; max-width: 60ch; padding: 0.2rem 0 0.2rem 1.6rem; border-left: 3px solid #4F5B45; font-family: 'Archivo', sans-serif; font-weight: 800; font-size: 1.9rem; line-height: 1.35; }
  @media screen and (min-width: 750px) { .bryda-varfor-{{ section.id }} .highlight { font-size: 2.1rem; } }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width bryda-varfor-{{ section.id }}">
    <div class="wrap">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.highlight != blank -%}<p class="highlight">{{ section.settings.highlight }}</p>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bryda Text",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Färgschema", "default": "background-2" },
    { "type": "text", "id": "eyebrow", "label": "Etikett" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Rubrik" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "textarea", "id": "highlight", "label": "Framhävd rad" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "presets": [ { "name": "Bryda Text" } ]
}
{% endschema %}
