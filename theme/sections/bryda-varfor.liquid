{%- style -%}
  .bryda-varfor-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  .bryda-varfor-{{ section.id }} .inner { max-width: 64rem; margin: 0 auto; }
  .bryda-varfor-{{ section.id }} .eyebrow { font-family: var(--font-mono-family); font-size: 1.2rem; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.6; margin: 0 0 1.4rem; }
  .bryda-varfor-{{ section.id }} h2 { font-size: clamp(2.8rem, 4.4vw, 4.2rem); margin: 0 0 2rem; }
  .bryda-varfor-{{ section.id }} .text { font-size: 1.7rem; line-height: 1.6; }
  .bryda-varfor-{{ section.id }} .text p { margin: 0 0 1.2rem; }
  .bryda-varfor-{{ section.id }} .highlight { margin: 2.4rem 0 0; padding: 0.4rem 0 0.4rem 1.6rem; border-left: 3px solid #4F5B45; font-family: 'Archivo', sans-serif; font-weight: 800; font-size: 2rem; line-height: 1.3; }
  @media screen and (max-width: 749px) {
    .bryda-varfor-{{ section.id }} .text { font-size: 1.6rem; }
    .bryda-varfor-{{ section.id }} .highlight { font-size: 1.8rem; }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width bryda-varfor-{{ section.id }}">
    <div class="inner">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.highlight != blank -%}<p class="highlight">{{ section.settings.highlight }}</p>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bryda Varför inget funkat",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Färgschema", "default": "background-2" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Varför det inte funkat förut" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "highlight", "label": "Framhävd rad" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "presets": [ { "name": "Bryda Varför inget funkat" } ]
}
{% endschema %}
