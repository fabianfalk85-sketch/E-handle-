{%- style -%}
  .bryda-steps-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .bryda-steps-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
  .bryda-steps-{{ section.id }} .wrap { max-width: 100rem; }
  .bryda-steps-{{ section.id }} .eyebrow { font-family: var(--font-mono-family); font-size: 1.3rem; line-height: 1.5; letter-spacing: 0.04em; color: #4F5B45; margin: 0 0 1.2rem; max-width: 60ch; }
  .bryda-steps-{{ section.id }} h2 { font-size: clamp(2.8rem, 2.2rem + 1.8vw, 4rem); line-height: 1.05; margin: 0; max-width: 24ch; text-wrap: balance; }
  .bryda-steps-{{ section.id }} .text { margin-top: 2rem; max-width: 60ch; }
  .bryda-steps-{{ section.id }} .text p { font-size: 1.7rem; line-height: 1.6; margin: 0 0 1.2rem; }
  .bryda-steps-{{ section.id }} .text p:last-child { margin-bottom: 0; }
  @media screen and (min-width: 750px) { .bryda-steps-{{ section.id }} .text p { font-size: 1.8rem; } }
  .bryda-steps-{{ section.id }} .steps { list-style: none; margin: 3.2rem 0 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 2.4rem; }
  .bryda-steps-{{ section.id }} .step { margin: 0; padding-top: 1.6rem; border-top: 1px solid rgba(var(--color-foreground), 0.15); display: grid; grid-template-columns: 4rem 1fr; column-gap: 1.2rem; }
  .bryda-steps-{{ section.id }} .step .n { font-family: var(--font-mono-family); font-size: 1.3rem; letter-spacing: 0.08em; color: #4F5B45; line-height: 2.4rem; }
  .bryda-steps-{{ section.id }} .step h3 { font-size: 2rem; line-height: 1.2; margin: 0; }
  .bryda-steps-{{ section.id }} .step p { grid-column: 2; font-size: 1.7rem; line-height: 1.6; margin: 0.4rem 0 0; }
  @media screen and (min-width: 750px) {
    .bryda-steps-{{ section.id }} .steps { grid-template-columns: repeat(3, 1fr); gap: 3.2rem; }
    .bryda-steps-{{ section.id }} .step { grid-template-columns: 1fr; }
    .bryda-steps-{{ section.id }} .step .n { margin-bottom: 0.8rem; }
    .bryda-steps-{{ section.id }} .step p { grid-column: 1; }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width bryda-steps-{{ section.id }}">
    <div class="wrap">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="text">{{ section.settings.text }}</div>{%- endif -%}
      <ol class="steps">
        {%- for block in section.blocks -%}
          <li class="step" {{ block.shopify_attributes }}>
            <span class="n" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bryda Hur Funkar Det",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Färgschema", "default": "background-1" },
    { "type": "text", "id": "eyebrow", "label": "Etikett" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Så funkar det" },
    { "type": "richtext", "id": "text", "label": "Text (valfri, visas mellan rubrik och steg)" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Steg",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Stryk på" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Tar några sekunder." }
      ]
    }
  ],
  "presets": [ { "name": "Bryda Hur Funkar Det" } ]
}
{% endschema %}
