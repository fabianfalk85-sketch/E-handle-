{%- style -%}
  .bryda-faq-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) { .bryda-faq-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
  .bryda-faq-{{ section.id }} .wrap { max-width: 100rem; }
  .bryda-faq-{{ section.id }} .eyebrow { font-family: var(--font-mono-family); font-size: 1.3rem; line-height: 1.5; letter-spacing: 0.04em; color: #4F5B45; margin: 0 0 1.2rem; max-width: 60ch; }
  .bryda-faq-{{ section.id }} h2 { font-size: clamp(2.8rem, 2.2rem + 1.8vw, 4rem); line-height: 1.05; margin: 0; max-width: 24ch; text-wrap: balance; }
  .bryda-faq-{{ section.id }} .text { margin-top: 2rem; max-width: 60ch; }
  .bryda-faq-{{ section.id }} .text p { font-size: 1.7rem; line-height: 1.6; margin: 0 0 1.2rem; }
  .bryda-faq-{{ section.id }} .text p:last-child { margin-bottom: 0; }
  @media screen and (min-width: 750px) { .bryda-faq-{{ section.id }} .text p { font-size: 1.8rem; } }
  .bryda-faq-{{ section.id }} .list { max-width: 76rem; margin: 3.2rem 0 0; border-top: 1px solid rgba(var(--color-foreground), 0.15); }
  .bryda-faq-{{ section.id }} details { border-bottom: 1px solid rgba(var(--color-foreground), 0.15); }
  .bryda-faq-{{ section.id }} summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1.6rem; min-height: 4.8rem; padding: 1.8rem 0; font-family: 'Archivo', sans-serif; font-weight: 700; font-size: 1.7rem; line-height: 1.35; }
  .bryda-faq-{{ section.id }} summary::-webkit-details-marker { display: none; }
  .bryda-faq-{{ section.id }} summary:focus-visible { outline: 2px solid #4F5B45; outline-offset: 2px; }
  .bryda-faq-{{ section.id }} .ico { flex: 0 0 14px; width: 14px; height: 14px; position: relative; }
  .bryda-faq-{{ section.id }} .ico::before, .bryda-faq-{{ section.id }} .ico::after { content: ''; position: absolute; left: 0; top: 6px; width: 14px; height: 2px; background: currentColor; transition: transform .2s; }
  .bryda-faq-{{ section.id }} .ico::after { transform: rotate(90deg); }
  .bryda-faq-{{ section.id }} details[open] .ico::after { transform: rotate(0); }
  .bryda-faq-{{ section.id }} .answer { padding: 0 0 2rem; max-width: 60ch; }
  .bryda-faq-{{ section.id }} .answer p { font-size: 1.7rem; line-height: 1.6; margin: 0 0 1rem; }
  .bryda-faq-{{ section.id }} .answer p:last-child { margin-bottom: 0; }
  .bryda-faq-{{ section.id }} .contact { margin-top: 2.4rem; max-width: 60ch; }
  .bryda-faq-{{ section.id }} .contact p { font-size: 1.7rem; line-height: 1.6; margin: 0; }
  @media screen and (min-width: 750px) { .bryda-faq-{{ section.id }} summary { font-size: 1.9rem; } }
  @media (prefers-reduced-motion: reduce) { .bryda-faq-{{ section.id }} .ico::after { transition: none; } }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width bryda-faq-{{ section.id }}">
    <div class="wrap">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="list">
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}<span class="ico" aria-hidden="true"></span></summary>
            <div class="answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
      {%- if section.settings.contact != blank -%}<div class="contact rte">{{ section.settings.contact }}</div>{%- endif -%}
    </div>
  </div>
</div>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{%- for block in section.blocks -%}{"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | strip | json }}}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Bryda FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Färgschema", "default": "background-1" },
    { "type": "text", "id": "eyebrow", "label": "Etikett" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Vanliga frågor" },
    { "type": "richtext", "id": "contact", "label": "Kontakttext" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Fråga",
      "settings": [
        { "type": "text", "id": "question", "label": "Fråga", "default": "Fråga" },
        { "type": "richtext", "id": "answer", "label": "Svar", "default": "<p>Svar</p>" }
      ]
    }
  ],
  "presets": [ { "name": "Bryda FAQ" } ]
}
{% endschema %}
